    </generalfeedback>
    <tags>
      <tag><text>[FACH]</text></tag>
      <tag><text>essay</text></tag>
    </tags>

    <answer fraction="0">
      <text></text>
    </answer>

    <responseformat>html</responseformat>
    <responserequired>1</responserequired>
    <responsefieldlines>15</responsefieldlines>
    <attachments>0</attachments>
    <attachmentsrequired>0</attachmentsrequired>
    <graderinfo format="html">
      <text><![CDATA[<p><strong>Musterlösung / Bewertungskriterien:</strong></p><ul><li>[KRITERIUM 1]</li><li>[KRITERIUM 2]</li></ul>]]></text>
    </graderinfo>
  </question>

