      <tag><text>[FACH]</text></tag>
      <tag><text>matching</text></tag>
    </tags>

    <subquestion>
      <text>[LINKS-ITEM 1]</text>
      <answer><text>[RECHTS-ANTWORT 1]</text></answer>
    </subquestion>
    <subquestion>
      <text>[LINKS-ITEM 2]</text>
      <answer><text>[RECHTS-ANTWORT 2]</text></answer>
    </subquestion>
    <subquestion>
      <text>[LINKS-ITEM 3]</text>
      <answer><text>[RECHTS-ANTWORT 3]</text></answer>
    </subquestion>
    <subquestion>
      <text>[LINKS-ITEM 4]</text>
      <answer><text>[RECHTS-ANTWORT 4]</text></answer>
    </subquestion>

    <shuffleanswers>true</shuffleanswers>
  </question>

  <!-- ============================================ -->
  <!-- 6. NUMERICAL                                -->
  <!-- ============================================ -->

  <question type="numerical">
    <name>
      <text>NUM_01_Numerisch_[TOPIC]</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[[RECHENAUFGABE]]]></text>
    </questiontext>
    <tags>
      <tag><text>[FACH]</text></tag>
      <tag><text>numerical</text></tag>
    </tags>

    <answer fraction="100">
      <text>[ZAHLENWERT]</text>
      <tolerance>[TOLERANZBEREICH, z.B. 0.5]</tolerance>
      <tolerancetype>relative</tolerancetype>
      <correctanswerformat>1</correctanswerformat>
      <correctanswerlength>2</correctanswerlength>
      <feedback><text>[FEEDBACK]</text></feedback>
    </answer>

    <unitsleft>0</unitsleft>
  </question>

  <!-- ============================================ -->
  <!-- 7. ESSAY / FREE TEXT                        -->
  <!-- ============================================ -->

  <question type="essay">
    <name>
      <text>ES_01_Freitext_[TOPIC]</text>
