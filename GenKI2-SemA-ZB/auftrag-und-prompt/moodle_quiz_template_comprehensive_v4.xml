<?xml version="1.0" encoding="UTF-8"?>
<quiz>
  <!--
    Comprehensive Moodle XML Template v4.0
    All question types aligned with Moodle 4.4+

    Guidelines:
    - Use UTF-8 encoding
    - Replace placeholders [TEXT] with actual content
    - Maintain fraction values as decimals (0.0 to 1.0)
    - One category per import recommended
    - Version tag enables format compatibility

    Structure:
    - Category anchors quiz in course structure
    - Description provides metadata context
    - Question types cover 23 major Moodle types
    - Each type includes: name, questiontext, tags, answers, feedback
  -->

  <!-- ============================================ -->
  <!-- CATEGORY & METADATA                         -->
  <!-- ============================================ -->

  <question type="category">
    <category>
      <text>$course$/[THEMA]/[SUBTHEMA]</text>
    </category>
  </question>

  <question type="description">
    <name>
      <text>Beschreibung: Quiz Kontext &amp; Anweisungen</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[
<h2>[QUIZ-TITEL]</h2>
<p><strong>Zielgruppe:</strong> [ZIELGRUPPE]</p>
<p><strong>Dauer:</strong> [DAUER] Minuten</p>
<p><strong>Anweisungen:</strong> [ANWEISUNGEN]</p>
<p><strong>Schwierigkeitsgrad:</strong> [LEVEL: leicht/mittel/schwer]</p>
      ]]></text>
    </questiontext>
    <tags>
      <tag><text>[FACH]</text></tag>
      <tag><text>[THEMA]</text></tag>
    </tags>
  </question>

  <!-- ============================================ -->
  <!-- 1. MULTIPLE CHOICE (Single Answer)         -->
  <!-- ============================================ -->

  <question type="multichoice">
    <name>
      <text>MC_01_Einzelantwort_[TOPIC]</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[[MC-FRAGE-TEXT]]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[[ALLGEMEINES FEEDBACK ZUR FRAGE]]]></text>
    </generalfeedback>
    <tags>
      <tag><text>[FACH]</text></tag>
      <tag><text>[THEMA]</text></tag>
      <tag><text>multichoice</text></tag>
    </tags>

    <answer fraction="100">
      <text>[KORREKTE ANTWORT]</text>
      <feedback><text>[FEEDBACK ZUR RICHTIGEN ANTWORT]</text></feedback>
    </answer>
    <answer fraction="0">
      <text>[FALSCHE ANTWORT 1]</text>
      <feedback><text>[DISTRAKTOR-FEEDBACK 1]</text></feedback>
    </answer>
    <answer fraction="0">
      <text>[FALSCHE ANTWORT 2]</text>
      <feedback><text>[DISTRAKTOR-FEEDBACK 2]</text></feedback>
    </answer>
    <answer fraction="0">
      <text>[FALSCHE ANTWORT 3]</text>
      <feedback><text>[DISTRAKTOR-FEEDBACK 3]</text></feedback>
    </answer>

    <shuffleanswers>1</shuffleanswers>
    <single>true</single>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html">
      <text>Richtig!</text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text>Teilweise richtig.</text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text>Leider falsch.</text>
    </incorrectfeedback>
  </question>

  <!-- ============================================ -->
  <!-- 2. MULTIPLE CHOICE (Multiple Answers)      -->
  <!-- ============================================ -->

  <question type="multichoice">
    <name>
      <text>MC_02_Mehrfachantwort_[TOPIC]</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[[FRAGE MIT MEHRFACHANTWORT]]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[[ALLGEMEINES FEEDBACK]]]></text>
    </generalfeedback>
    <tags>
      <tag><text>[FACH]</text></tag>
      <tag><text>[THEMA]</text></tag>
    </tags>

    <answer fraction="50">
      <text>[KORREKTE ANTWORT 1]</text>
      <feedback><text>[FEEDBACK]</text></feedback>
    </answer>
    <answer fraction="50">
      <text>[KORREKTE ANTWORT 2]</text>
      <feedback><text>[FEEDBACK]</text></feedback>
    </answer>
    <answer fraction="0">
      <text>[FALSCHE ANTWORT]</text>
      <feedback><text>[FEEDBACK]</text></feedback>
    </answer>

    <shuffleanswers>1</shuffleanswers>
    <single>false</single>
    <answernumbering>abc</answernumbering>
    <correctfeedback format="html">
      <text>Alle richtigen Antworten gewählt!</text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text>Teilweise korrekt.</text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text>Keine oder teilweise richtige Antworten.</text>
    </incorrectfeedback>
  </question>

  <!-- ============================================ -->
  <!-- 3. TRUE/FALSE                               -->
  <!-- ============================================ -->

  <question type="truefalse">
    <name>
      <text>TF_01_Wahrfalsch_[TOPIC]</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[[AUSSAGE WAHR/FALSCH]]]></text>
    </questiontext>
    <tags>
      <tag><text>[FACH]</text></tag>
      <tag><text>truefalse</text></tag>
    </tags>

    <answer fraction="100">
      <text>true</text>
      <feedback><text>[FEEDBACK WENN WAHR]</text></feedback>
    </answer>
    <answer fraction="0">
      <text>false</text>
      <feedback><text>[FEEDBACK WENN FALSCH]</text></feedback>
    </answer>
  </question>

  <!-- ============================================ -->
  <!-- 4. SHORT ANSWER                             -->
  <!-- ============================================ -->

  <question type="shortanswer">
    <name>
      <text>SA_01_Kurzantwort_[TOPIC]</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[[FRAGE MIT TEXTANTWORT]]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[[ALLGEMEINES FEEDBACK]]]></text>
    </generalfeedback>
    <tags>
      <tag><text>[FACH]</text></tag>
      <tag><text>shortanswer</text></tag>
    </tags>

    <answer fraction="100">
      <text>[KORREKTE ANTWORT 1]</text>
      <feedback><text>[FEEDBACK]</text></feedback>
    </answer>
    <answer fraction="100">
      <text>[KORREKTE ANTWORT 2]</text>
      <feedback><text>[FEEDBACK]</text></feedback>
    </answer>
    <answer fraction="0">
      <text>*</text>
      <feedback><text>Die korrekte Antwort ist: [KORREKTE ANTWORT]</text></feedback>
    </answer>

    <usecase>0</usecase>
  </question>

  <!-- ============================================ -->
  <!-- 5. MATCHING / ZUORDNUNG                     -->
  <!-- ============================================ -->

  <question type="match">
    <name>
      <text>MA_01_Zuordnung_[TOPIC]</text>
