    <questiontext format="html">
      <text><![CDATA[
<p>Der prozess hat {1:MULTICHOICE:=OPTION1~OPTION2~OPTION3} mehrere Phasen.
In der ersten Phase werden {2:SHORTANSWER:=[ANTWORT1]~[ANTWORT2]~*} durchgeführt.</p>
      ]]></text>
    </questiontext>
    <tags>
      <tag><text>[FACH]</text></tag>
      <tag><text>cloze</text></tag>
    </tags>

    <answer fraction="0">
      <text></text>
    </answer>
  </question>

  <!-- ============================================ -->
  <!-- 9. CALCULATED (Simple)                      -->
  <!-- ============================================ -->

  <question type="calculatedsimple">
    <name>
      <text>CALC_01_EinfachBerechnet_[TOPIC]</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[
<p>Berechne: {a} + {b} = ?</p>
<p>Weitere Erklärung: {a} und {b} sind zufällige Variablen.</p>
      ]]></text>
    </questiontext>
    <tags>
      <tag><text>[FACH]</text></tag>
      <tag><text>calculated</text></tag>
    </tags>

    <answer fraction="100">
      <text>{a}+{b}</text>
      <tolerance>0.01</tolerance>
      <feedback><text>[FEEDBACK]</text></feedback>
      <tolerance_type>relative</tolerance_type>
    </answer>

    <!-- Dataset Definition -->
    <dataset_definitions>
      <dataset_definition>
        <status>private</status>
        <name>a</name>
        <type>calculated</type>
        <distribution>uniform</distribution>
        <max>100</max>
        <min>1</min>
        <length>0</length>
        <decimals>0</decimals>
        <itemcount>10</itemcount>
        <dataset_items>
          <dataset_item>
            <number>1</number>
            <value>5</value>
          </dataset_item>
          <!-- ... weitere Items ... -->
        </dataset_items>
      </dataset_definition>
    </dataset_definitions>
  </question>

